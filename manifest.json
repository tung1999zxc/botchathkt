{
  "manifest_version": 3,
  "name": "Ads Manager Pro TL_",
  "version": "10.0",
  "key": "",
  "description": "Công cụ phân tích và quản lý quỹ tài khoản quảng cáo Facebook chuyên nghiệp.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "cookies",
    "browsingData",
    "alarms"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.google.com/*",
    "https://*.googleapis.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://api.telegram.org/*",
    "https://api.openai.com/*",
    "https://*.workers.dev/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Mở Ads Manager Pro TL_"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://business.facebook.com/latest/inbox/*",
        "https://business.facebook.com/inbox/*",
        "https://www.facebook.com/messages/*"
      ],
      "js": ["content_inbox.js"],
      "run_at": "document_idle"
    }
  ]
}